{
  "name": "scan-fix-verify",
  "description": "Scan a target, fix the findings on a bank, verify the fix.",
  "version": "1.0.0",
  "nodes": {
    "fix": {
      "id": "fix",
      "type": "NODE_TYPE_JOB",
      "jobConfig": {
        "bankRef": "FIXME-bank",
        "spec": {
          "goal": "Fix every finding the scan node reported. Add a regression test for each fix.",
          "repositories": [
            {
              "name": "app",
              "connectorRef": "connector/gitlab",
              "project": "group/repo",
              "baseBranch": "main",
              "deliverable": "DELIVERABLE_KIND_MERGE_REQUEST"
            }
          ],
          "inputs": [
            "scan"
          ],
          "acceptance": {
            "verifierComponent": "agent/webvuln-agent",
            "passingScore": 0.8,
            "maxPasses": 3
          }
        },
        "constraints": {
          "maxTurns": 40
        }
      },
      "timeout": "5400s"
    },
    "scan": {
      "id": "scan",
      "type": "NODE_TYPE_AGENT",
      "agentConfig": {
        "agentName": "webvuln-agent"
      }
    }
  },
  "edges": [
    {
      "from": "scan",
      "to": "fix"
    }
  ],
  "entryPoints": [
    "scan"
  ],
  "exitPoints": [
    "fix"
  ]
}
