BINARY := {{.Name}}

.PHONY: proto build test register run image

## proto: regenerate Go bindings from api/proto/gibson/tools/{{.ProtoPkg}}/v1/{{.ProtoPkg}}.proto.
## Requires buf (https://buf.build/docs/installation), protoc-gen-go, and
## protoc-gen-go-grpc on PATH.
proto:
	buf generate

## build: compile the tool binary.
build:
	CGO_ENABLED=0 go build -o $(BINARY) .

## test: run unit tests.
test:
	go test ./...

## register: run the capability-grant enrollment handshake.
## Paste the single-use bootstrap token from the dashboard's Register wizard.
register:
	@echo "Run: gibson component register --token <bootstrap-token>"
	@echo "Get the bootstrap token from the Gibson dashboard's Register Tool wizard."

## run: run the compiled binary; reads the runtime credential from ~/.gibson/tool/.
run: build
	gibson component run

## image: build the container image.
image:
	docker build -t $(BINARY):{{.Version}} .
