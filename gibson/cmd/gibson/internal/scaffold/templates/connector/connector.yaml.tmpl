# {{.Name}} connector — a declarative MCP integration (ADR-0065 R6).
#
# This manifest IS the connector: no Go, no image build. It has the shape of
# an entry of the platform catalog that gibson embeds
# (internal/platform/componentcatalog/manifests/<id>.yaml in zeroroot-ai/gibson).
# gibson derives a catalog entry from it and reconciles a ConnectorInstance.
# Edit the fields for your vendor; `go test ./...` validates the shape.
id: {{.Name}}
kind: connector
displayName: {{.GoName}}
description: >-
  TODO: one sentence describing the tools this connector exposes.
egressAllow:
  - REPLACE-ME.example.com:443
spec:
  vendor: {{.Name}}
  # shape: Remote  → a vendor-hosted MCP server gibson proxies (set endpoint,
  #                  never image).
  #        Hosted  → a container image gibson runs on ToolHive (set image,
  #                  never endpoint).
  shape: Remote
  endpoint: https://REPLACE-ME.example.com/api/mcp
  transport: streamable-http
  # auth: none | secret | oauth. Set oauthScope when auth is oauth.
  auth: oauth
  oauthScope: mcp
