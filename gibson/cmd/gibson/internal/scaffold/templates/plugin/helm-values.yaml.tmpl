# Helm wiring stub for the {{.Name}} plugin.
#
# Add this fragment under the gibson umbrella chart's `plugins:` map to deploy
# this plugin as a pod-runtime workload. Build the image with `make image` and
# push it to a registry that you own. Set `repository` to that image. Before
# production, pin the digest of the pushed image rather than a moving tag.
{{.Name}}:
  enabled: true
  image:
    repository: REPLACE-ME.example.com/{{.Name}}
    tag: {{.Version}}
  runtime: pod
  # secrets: the broker resolves any cred:/provider_config: names declared in
  # plugin.yaml; nothing is passed through Helm values.
